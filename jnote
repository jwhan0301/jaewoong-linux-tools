#!/bin/bash

NOTE_DIR="$HOME/linux-quest/notes"
NOTE_FILE="$NOTE_DIR/jnote.txt"
ARCHIVE_FILE="$NOTE_DIR/archive.txt"

UNDO_DIR="$NOTE_DIR/.undo"
UNDO_NOTE_FILE="$UNDO_DIR/jnote.txt"
UNDO_ARCHIVE_FILE="$UNDO_DIR/archive.txt"
UNDO_META_FILE="$UNDO_DIR/action.txt"

mkdir -p "$NOTE_DIR"

show_usage() {
    echo "Usage:"
    echo "  jnote add MESSAGE"
    echo "  jnote list"
    echo "  jnote show NUMBER"
    echo "  jnote search KEYWORD"
    echo "  jnote count"
    echo "  jnote edit NUMBER MESSAGE"
    echo "  jnote delete NUMBER"
    echo "  jnote undo"
    echo "  jnote clear"
    echo "  jnote clear --yes"
    echo "  jnote export FILE"
    echo "  jnote import FILE"
    echo "  jnote today"
    echo "  jnote recent [NUMBER]"
    echo "  jnote backup"
    echo "  jnote archive NUMBER"
    echo "  jnote archived"
    echo "  jnote restore NUMBER"
}

note_count() {
    if [ -f "$NOTE_FILE" ]; then
        wc -l < "$NOTE_FILE" | tr -d ' '
    else
        echo 0
    fi
}

validate_note_number() {
    local number="$1"
    local total

    case "$number" in
        ''|*[!0-9]*)
            echo "Invalid note number: $number"
            return 1
            ;;
    esac

    total=$(note_count)

    if [ "$total" -eq 0 ]; then
        echo "No notes yet."
        return 1
    fi

    if [ "$number" -lt 1 ] || [ "$number" -gt "$total" ]; then
        echo "Invalid note number: $number"
        echo "Valid range: 1-$total"
        return 1
    fi

    return 0
}
save_snapshot() {
    local action="$1"

    mkdir -p "$UNDO_DIR"

    if [ -f "$NOTE_FILE" ]; then
        cp "$NOTE_FILE" "$UNDO_NOTE_FILE"
    else
        : > "$UNDO_NOTE_FILE"
    fi

    if [ -f "$ARCHIVE_FILE" ]; then
        cp "$ARCHIVE_FILE" "$UNDO_ARCHIVE_FILE"
    else
        : > "$UNDO_ARCHIVE_FILE"
    fi

    printf '%s\n' "$action" > "$UNDO_META_FILE"
}

restore_snapshot() {
    local action

    if [ ! -f "$UNDO_META_FILE" ]; then
        echo "Nothing to undo."
        return 1
    fi

    action=$(cat "$UNDO_META_FILE")

    cp "$UNDO_NOTE_FILE" "$NOTE_FILE"
    cp "$UNDO_ARCHIVE_FILE" "$ARCHIVE_FILE"

    rm -rf -- "$UNDO_DIR"

    echo "Undid: $action"
}

command="$1"

case "$command" in
    add)
        if [ $# -lt 2 ]; then
            echo "Usage: jnote add MESSAGE"
            exit 1
        fi

        shift
save_snapshot "add"

        echo "$(date '+%Y-%m-%d %H:%M:%S') | $*" >> "$NOTE_FILE"
        echo "Note added."
        ;;

    list)
        if [ -s "$NOTE_FILE" ]; then
            cat -n "$NOTE_FILE"
        else
            echo "No notes yet."
        fi
        ;;

    show)
        number="$2"

        if [ $# -lt 2 ]; then
            echo "Usage: jnote show NUMBER"
            exit 1
        fi

        validate_note_number "$number" || exit 1

        sed -n "${number}p" "$NOTE_FILE"
        ;;

    search)
        keyword="$2"

        if [ $# -lt 2 ]; then
            echo "Usage: jnote search KEYWORD"
            exit 1
        fi

        if [ -s "$NOTE_FILE" ]; then
            grep -n -i "$keyword" "$NOTE_FILE" || echo "No matching notes."
        else
            echo "No notes yet."
        fi
        ;;

    count)
        count=$(note_count)
        echo "Total notes: $count"
        ;;

    edit)
        number="$2"

        if [ $# -lt 3 ]; then
            echo "Usage: jnote edit NUMBER MESSAGE"
            exit 1
        fi

        validate_note_number "$number" || exit 1
        save_snapshot "edit $number"

        shift 2
        message="$*"
        temp_file=$(mktemp)

        awk -v target="$number" -v replacement="$(date '+%Y-%m-%d %H:%M:%S') | $message" '
            NR == target {
                print replacement
                next
            }
            {
                print
            }
        ' "$NOTE_FILE" > "$temp_file"

        mv "$temp_file" "$NOTE_FILE"
        echo "Edited note: $number"
        ;;

    delete)
        number="$2"

        if [ $# -lt 2 ]; then
            echo "Usage: jnote delete NUMBER"
            exit 1
        fi

        validate_note_number "$number" || exit 1
        save_snapshot "delete $number"

        sed -i "${number}d" "$NOTE_FILE"
        echo "Deleted note: $number"
        ;;

    clear)
        auto_yes="$2"

        if [ "$auto_yes" != "--yes" ] && [ "$auto_yes" != "-y" ]; then
            echo "This will remove all notes. Continue? [y/N]"
            read -r answer

            if [ "$answer" != "y" ] && [ "$answer" != "Y" ]; then
                echo "Clear canceled."
                exit 0
            fi
        fi

        save_snapshot "clear"

        : > "$NOTE_FILE"
        echo "All notes cleared."
        ;;

    export)
        target="$2"

        if [ $# -lt 2 ]; then
            echo "Usage: jnote export FILE"
            exit 1
        fi

        if [ ! -s "$NOTE_FILE" ]; then
            echo "No notes to export."
            exit 1
        fi

        target_dir=$(dirname "$target")
        mkdir -p "$target_dir"

        cp "$NOTE_FILE" "$target"
        echo "Exported notes to: $target"
        ;;

    import)
        source_file="$2"

        if [ $# -lt 2 ]; then
            echo "Usage: jnote import FILE"
            exit 1
        fi

        if [ ! -f "$source_file" ]; then
            echo "Import file does not exist: $source_file"
            exit 1
        fi

        if [ ! -s "$source_file" ]; then
            echo "Import file is empty: $source_file"
            exit 1
        fi

        source_real=$(readlink -f "$source_file")
        note_real=$(readlink -f "$NOTE_FILE")

        if [ "$(readlink -f "$source_file")" = "$(readlink -f "$NOTE_FILE")" ]; then
            echo "Cannot import the note file into itself."
            exit 1
        fi

        imported_count=$(awk 'END { print NR }' "$source_file")

        save_snapshot "import $source_file"

        cat "$source_file" >> "$NOTE_FILE"

        echo "Imported notes: $imported_count"
        echo "Source: $source_file"
        ;;
        
     today)
        today_date=$(date '+%Y-%m-%d')

        if [ ! -s "$NOTE_FILE" ]; then
            echo "No notes yet."
            exit 0
        fi

        if ! grep -n "^$today_date " "$NOTE_FILE"; then
            echo "No notes for today."
        fi
        ;;

     recent)
        number="${2:-5}"

        case "$number" in
            ''|*[!0-9]*)
                echo "Invalid number: $number"
                echo "Usage: jnote recent [NUMBER]"
                exit 1
                ;;
        esac

        if [ "$number" -lt 1 ]; then
            echo "NUMBER must be at least 1."
            exit 1
        fi

        if [ ! -s "$NOTE_FILE" ]; then
            echo "No notes yet."
            exit 0
        fi

        nl -ba "$NOTE_FILE" | tail -n "$number"
        ;;

    backup)
        if [ ! -s "$NOTE_FILE" ]; then
            echo "No notes to back up."
            exit 1
        fi

        backup_dir="$NOTE_DIR/backups"
        timestamp=$(date '+%Y%m%d-%H%M%S')
        target="$backup_dir/jnote-$timestamp.txt"

        mkdir -p "$backup_dir"
        cp "$NOTE_FILE" "$target"

        echo "Backup created: $target"
        ;;

    archive)
        number="$2"

        if [ $# -lt 2 ]; then
            echo "Usage: jnote archive NUMBER"
            exit 1
        fi

        validate_note_number "$number" || exit 1
        save_snapshot "archive $number"

        archived_note=$(sed -n "${number}p" "$NOTE_FILE")

        printf '%s\n' "$archived_note" >> "$ARCHIVE_FILE"
        sed -i "${number}d" "$NOTE_FILE"

        echo "Archived note: $number"
        ;;

    archived)
        if [ -s "$ARCHIVE_FILE" ]; then
            cat -n "$ARCHIVE_FILE"
        else
            echo "No archived notes."
        fi
        ;;

    restore)
        number="$2"

        if [ $# -lt 2 ]; then
            echo "Usage: jnote restore NUMBER"
            exit 1
        fi

        case "$number" in
            ''|*[!0-9]*)
                echo "Invalid archive number: $number"
                exit 1
                ;;
        esac

        if [ ! -s "$ARCHIVE_FILE" ]; then
            echo "No archived notes."
            exit 1
        fi

        total=$(wc -l < "$ARCHIVE_FILE" | tr -d ' ')

        if [ "$number" -lt 1 ] || [ "$number" -gt "$total" ]; then
            echo "Invalid archive number: $number"
            echo "Valid range: 1-$total"
            exit 1
        fi

        restored_note=$(sed -n "${number}p" "$ARCHIVE_FILE")
        save_snapshot "restore $number"

        printf '%s\n' "$restored_note" >> "$NOTE_FILE"
        sed -i "${number}d" "$ARCHIVE_FILE"

        echo "Restored archived note: $number"
        ;;

    undo)
        restore_snapshot || exit 1
        ;;

    *)
        show_usage
        ;;

esac
